// Shared build settings for the TheoRaff app target. Committed.
//
// Each person signs with their own free Apple ID. Two free accounts can't
// share one bundle ID, so every laptop adds its own suffix.
// Copy Local.xcconfig.example to Local.xcconfig (gitignored) and fill it in.

DEVELOPMENT_TEAM =
BUNDLE_ID_SUFFIX =

#include? "Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.theoraff.TheoRaff$(BUNDLE_ID_SUFFIX)
